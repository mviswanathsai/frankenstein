        "expected_arguments": {"customer_id":"c-7"}
      },
      {
        "name": "order_lookup",
        "description": "Look up an order by order_id.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"order_id":{"type":"string"}},"required":["order_id"]},
        "response": "order o-9 is paid",
        "expected_arguments": {"order_id":"o-9"}
      },
      {
        "name": "shipment_lookup",
        "description": "Look up a shipment by shipment_id.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"shipment_id":{"type":"string"}},"required":["shipment_id"]},
        "response": "shipment s-3 is delivered",
