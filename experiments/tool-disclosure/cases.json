    "tools": [
      {
        "name": "weather_current",
        "description": "Return current weather for a city.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"city":{"type":"string"}},"required":["city"]},
        "response": "Paris current weather is clear",
        "expected_arguments": {"city":"Paris"}
      },
      {
        "name": "weather_archive",
        "description": "Return archived weather for a city and date.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"city":{"type":"string"},"date":{"type":"string"}},"required":["city","date"]},
        "response": "archive response"
      },
      {
        "name": "weather_alarm",
        "description": "Create a weather alarm.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"city":{"type":"string"},"threshold":{"type":"number"}},"required":["city","threshold"]},
        "response": "alarm response"
      }
