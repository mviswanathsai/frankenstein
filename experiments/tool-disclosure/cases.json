  {
    "id": "nested-array",
    "prompt": "Price order ORDER-Beta-3 with exactly two line items. First item: item_id SKU-Red-01, quantity 2, unit_price 19.5. Second item: item_id SKU-Blue-02, quantity 5, unit_price 4.25. Discover and use exactly one hidden price_order tool call, then finish with SENTINEL:NESTED-ARRAY.",
    "expected_final_contains": "SENTINEL:NESTED-ARRAY",
    "tools": [
      {
        "name": "price_order",
        "description": "Price one order. Use order_id and an items array. Each item has item_id, quantity, and unit_price.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"order_id":{"type":"string"},"items":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"item_id":{"type":"string"},"quantity":{"type":"integer"},"unit_price":{"type":"number"}},"required":["item_id","quantity","unit_price"]}}},"required":["order_id","items"]},
        "response": "order ORDER-Beta-3 priced",
        "expected_arguments": {"order_id":"ORDER-Beta-3","items":[{"item_id":"SKU-Red-01","quantity":2,"unit_price":19.5},{"item_id":"SKU-Blue-02","quantity":5,"unit_price":4.25}]}
      }
    ],
    "expected_backend_calls": [
      {"name":"price_order","arguments":{"order_id":"ORDER-Beta-3","items":[{"item_id":"SKU-Red-01","quantity":2,"unit_price":19.5},{"item_id":"SKU-Blue-02","quantity":5,"unit_price":4.25}]}}
    ]
  },
