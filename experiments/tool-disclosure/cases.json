    "expected_final_contains": "SENTINEL:NESTED-COMBINED",
    "tools": [
      {
        "name": "schedule_fulfillment",
        "description": "Schedule one fulfillment. Use order with customer, delivery, and line_items. Each line item has item_id, quantity, unit_price, options, and tags.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"order":{"type":"object","additionalProperties":false,"properties":{"order_id":{"type":"string"},"customer":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string"},"vip":{"type":"boolean"}},"required":["id","vip"]},"delivery":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"object","additionalProperties":false,"properties":{"street":{"type":"string"},"city":{"type":"string"},"postal_code":{"type":"string"},"country":{"type":"string"}},"required":["street","city","postal_code","country"]},"window":{"type":"object","additionalProperties":false,"properties":{"start":{"type":"string"},"end":{"type":"string"}},"required":["start","end"]}},"required":["address","window"]},"line_items":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"item_id":{"type":"string"},"quantity":{"type":"integer"},"unit_price":{"type":"number"},"options":{"type":"object","additionalProperties":false,"properties":{"gift_wrap":{"type":"boolean"},"priority":{"type":"integer"}},"required":["gift_wrap","priority"]},"tags":{"type":"array","items":{"type":"string"}}},"required":["item_id","quantity","unit_price","options","tags"]}}},"required":["order_id","customer","delivery","line_items"]}},"required":["order"]},
