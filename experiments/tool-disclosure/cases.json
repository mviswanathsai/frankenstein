[
  {
    "id": "one-hidden-once",
    "prompt": "Find the total for invoice inv-001. Discover and use the hidden invoice_total tool, then finish with SENTINEL:ONE-HIDDEN-ONCE.",
    "expected_final_contains": "SENTINEL:ONE-HIDDEN-ONCE",
    "tools": [
      {
        "name": "invoice_total",
        "description": "Return the total for an invoice. Use invoice_id.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"invoice_id":{"type":"string"}},"required":["invoice_id"]},
        "response": "invoice inv-001 total is 42",
        "expected_arguments": {"invoice_id":"inv-001"}
      }
    ],
    "expected_backend_calls": [
      {"name":"invoice_total","arguments":{"invoice_id":"inv-001"}}
    ]
  },
  {
    "id": "one-hidden-repeated",
