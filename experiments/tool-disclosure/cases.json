    "tools": [
      {
        "name": "invoice_total",
        "description": "Return the total for one invoice. Use invoice_id.",
        "schema": {"type":"object","additionalProperties":false,"properties":{"invoice_id":{"type":"string"}},"required":["invoice_id"]},
        "response": "invoice total returned",
